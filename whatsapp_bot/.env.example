# Same Postgres database as the main Reclaimr app — this service reads/writes
# the same tables (orders, receivables, payables, users, whatsapp_numbers, ...).
# e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Groq API key — same provider/model already used by the main app's AI Advisor.
GROQ_API_KEY=

# WhatsApp Cloud API (Meta) — from your Meta App's WhatsApp product settings.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Arbitrary strong random string you choose yourself and also paste into the
# Meta webhook configuration screen — proves the GET /webhook handshake is
# really Meta calling you. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
WHATSAPP_VERIFY_TOKEN=
