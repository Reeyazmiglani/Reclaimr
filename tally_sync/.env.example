# Tally's own HTTP gateway (Gateway of Tally -> F1 (Help) -> Settings ->
# Connectivity -> Client/Server Configuration -> "Enable ODBC"/HTTP port).
# Default port is 9000; this only works while Tally is running on the same
# machine (or reachable over the LAN) as this script.
TALLY_URL=http://localhost:9000

# Exact company name as it appears in Tally (Gateway of Tally splash /
# "Select Company" list) — sent as SVCURRENTCOMPANY so the sync targets the
# right one even if a different company happens to be open in the Tally UI.
# Leave blank to use whichever company is currently open.
TALLY_COMPANY=

# The already-deployed whatsapp_bot service's public URL, e.g.
# https://reclaimr-whatsapp-bot.up.railway.app
WHATSAPP_BOT_URL=

# Must match the TALLY_SYNC_SECRET set on the whatsapp_bot Railway service.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
TALLY_SYNC_SECRET=
